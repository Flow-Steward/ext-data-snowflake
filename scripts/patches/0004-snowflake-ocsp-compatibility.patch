 }
+
+// flowStewardSnowflakeDSN supplies the fixed driver connection parameters.
+func flowStewardSnowflakeDSN(user, password, account, database, schema, warehouse, role string) string {
+	return fmt.Sprintf("%s:%s@%s/%s/%s?warehouse=%s&role=%s&ocspFailOpen=true", user, password, account, database, schema, warehouse, role)
+}
